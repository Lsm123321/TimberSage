## 基础服务镜像（可按需覆盖）
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z

## MySQL root 密码（必填：compose 与后端容器共用此变量；改密码时先 ALTER USER 再同步这里）
MYSQL_ROOT_PASSWORD=请替换为你的MySQL密码

## MinIO 账号密码（必填：compose 与后端容器共用此变量；改密码需重建 minio 容器生效）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=请替换为你的MinIO密码

## Docker Compose 工程名（重要：用于固定数据卷/网络命名，避免因目录改名导致“数据看似丢失”）
# 建议保持为原工程名；如果你确定是全新环境，也可以改成 TimberSage
COMPOSE_PROJECT_NAME=new_project

## 前后端构建基础镜像（可按需覆盖）
BACKEND_MAVEN_IMAGE=maven:3.9-eclipse-temurin-17-alpine
BACKEND_RUNTIME_IMAGE=eclipse-temurin:17-jre-alpine
FRONTEND_NODE_IMAGE=node:20-alpine
FRONTEND_NGINX_IMAGE=nginx:alpine

## 应用运行时可选环境变量
# 用于后端拼出 MinIO 公网访问地址（通过前端 Nginx 反代 /minio 保证同源）
# FRONTEND_PUBLIC_BASE_URL=http://localhost:18088

# 后端 CORS：浏览器用公网 IP/域名访问前端时，必须把对应 Origin 模式加进来，否则登录等接口会 403
# 示例（逗号分隔、无空格）：CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://你的公网IP:*

# DeepSeek API Key（生产环境务必通过环境变量注入）
# SPRING_DEEPSEEK_API_KEY=

# 智谱 AI Key（TTS 语音合成 + 声音克隆 + DeepSeek 拥堵时的 chat 备用通道）
# ZHIPU_API_KEY=

# JWT 签名密钥（至少 32 字节的随机串，生产环境务必替换）
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 至少 32 字节；后端启动时会校验长度，弱密钥或示例值会直接拒绝启动
JWT_SECRET=请替换为你自己生成的随机串（至少32字节）
